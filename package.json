{
	"name": "void-monorepo",
	"version": "0.0.0",
	"private": true,
	"description": "",
	"author": "marigold",
	"workspaces": [
		"./packages/shared",
		"./packages/runtime",
		"./packages/compiler"
	],
	"scripts": {
		"lint": "biome check --max-diagnostics=159",
		"build": "rollup -c",
		"test": "bun test --concurrent --randomize --rerun-each 1",
		"testRuntime": "bun run test ./packages/runtime",
		"testCompiler": "bun run test ./packages/compiler",
		"testCov": "bun run test --coverage --coverage-reporter=lcov --coverage-dir=coverage"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.6",
		"@happy-dom/global-registrator": "^20.9.0",
		"@rollup/plugin-typescript": "^12.3.0",
		"@types/bun": "^1.3.11",
		"oxfmt": "^0.44.0",
		"rollup": "^4.57.1",
		"rollup-plugin-dts": "^6.3.0",
		"tslib": "^2.8.1"
	}
}
