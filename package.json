{
    "name": "void-monorepo",
    "version": "0.0.0",
    "devDependencies": {
        "@biomejs/biome": "^2.4.6",
        "@types/bun": "latest"
    },
    "description": "",
    "private": true,
    "author": "marigold",
    "scripts": {
        "lint": "biome check --max-diagnostics=159",
        "build": "bun run --filter \"*\" --parallel build",
        "test": "bun test --concurrent --randomize --rerun-each 1",
        "testCompiler": "bun run test ./packages/void/src/compiler",
        "testCov": "bun run test --coverage --coverage-reporter=lcov --coverage-dir=coverage"
    },
    "workspaces": [
        "packages/void"
    ]
}
